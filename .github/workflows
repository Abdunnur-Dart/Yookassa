name: Daily Subscription Expire Cron

on:
  schedule:
    # Каждый день в 00:00 UTC
    - cron: '0 0 * * *'
  # Кнопка для ручного запуска во вкладке Actions
  workflow_dispatch:

jobs:
  expire-subscriptions:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Install Dependencies
        run: npm install

      - name: Run Expire Script
        # Загружаем serviceAccountKey из секретов GitHub во время выполнения
        env:
          SERVICE_ACCOUNT_KEY: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
        run: |
          echo "$SERVICE_ACCOUNT_KEY" > serviceAccountKey.json
          node expire-subscriptions.js
